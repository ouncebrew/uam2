diff --git a/src/compiler/nir/nir_search.c b/src/compiler/nir/nir_search.c
--- a/src/compiler/nir/nir_search.c
+++ b/src/compiler/nir/nir_search.c
@@ -753,6 +753,22 @@
    return true;
 }
 
+static unsigned
+filter_state(const struct per_op_table *tbl, uint16_t state)
+{
+   unsigned lo = 0, hi = tbl->num_filter_entries;
+   while (lo < hi) {
+      unsigned mid = (lo + hi) / 2;
+      if (tbl->filter_states[mid] < state)
+         lo = mid + 1;
+      else
+         hi = mid;
+   }
+   if (lo < tbl->num_filter_entries && tbl->filter_states[lo] == state)
+      return tbl->filter_values[lo];
+   return 0;
+}
